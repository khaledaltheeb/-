NEXT_PUBLIC_ALLOW_INDEXING=false

# Server/CLI only. Never expose this value with a NEXT_PUBLIC_ prefix or commit a real secret.
# Used by server-side Search V3 and selected import/admin workflows.
SUPABASE_SECRET_KEY=
# Legacy server-side alias supported by Search V3 if your deployment still uses it.
SUPABASE_SERVICE_ROLE_KEY=

# Search assistant rollout. Keep false until PR quality gates pass and the server-side secret is configured.
ENABLE_RAWAFID_ASSISTANT=false
# Optional semantic layer. The embedding worker refuses external work when this is absent.
OPENAI_API_KEY=

# Analytics are centralized in the root layout. Keep disabled in local/Codespaces/CI to avoid polluting production analytics.
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_GTM_ID=GTM-WBLQVBG4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-VLZMV8Y4JP
# Enable direct gtag only after confirming the GTM container does not already send GA4 page_view events.
NEXT_PUBLIC_ENABLE_DIRECT_GA=false
