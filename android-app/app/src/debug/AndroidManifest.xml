<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- Debug-only test surface so emulator smoke can simulate the AlarmManager PendingIntent.
             The release/main manifest keeps this receiver non-exported. -->
        <receiver
            android:name=".CompanionAlarmReceiver"
            android:exported="true"
            tools:replace="android:exported" />

        <!-- Debug-only probe that posts a real Rafiqa notification from a cold process.
             This receiver does not exist in release builds. -->
        <receiver
            android:name=".CompanionTestReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="org.healthrenewal.rawafid.debug.SEND_COMPANION_TEST" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
