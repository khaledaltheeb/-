<resources>
    <style name="Theme.Rawafid" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/rawafid_teal</item>
        <item name="colorOnPrimary">@color/rawafid_on_primary</item>
        <item name="colorSecondary">@color/companion_rose</item>
        <item name="colorSurface">@color/rawafid_surface</item>
        <item name="colorOnSurface">@color/rawafid_text_primary</item>
        <item name="colorSurfaceVariant">@color/rawafid_surface_alt</item>
        <item name="colorOnSurfaceVariant">@color/rawafid_text_secondary</item>
        <item name="android:colorAccent">@color/rawafid_teal</item>
        <item name="android:textColorPrimary">@color/rawafid_text_primary</item>
        <item name="android:textColorSecondary">@color/rawafid_text_secondary</item>
        <item name="android:windowBackground">@color/rawafid_bg</item>
        <item name="android:navigationBarColor">@color/rawafid_bg</item>
        <item name="android:statusBarColor">@color/rawafid_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:fontFamily">sans</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Rawafid.AlertDialog</item>
    </style>

    <style name="ThemeOverlay.Rawafid.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/rawafid_surface</item>
        <item name="colorOnSurface">@color/rawafid_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/rawafid_text_secondary</item>
        <item name="colorPrimary">@color/rawafid_teal</item>
        <item name="android:textColorPrimary">@color/rawafid_text_primary</item>
        <item name="android:textColorSecondary">@color/rawafid_text_secondary</item>
    </style>
</resources>
