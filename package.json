{
  "name": "rawafid-platform",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "architecture-check": "node scripts/quality-contract.mjs && node scripts/theme-contract-v4.mjs && node scripts/theme-dead-code-check.mjs && node scripts/provider-system-contract.mjs && node scripts/account-system-contract.mjs",
    "theme-check": "node scripts/theme-contract-v4.mjs && node scripts/theme-dead-code-check.mjs",
    "provider-system-check": "node scripts/provider-system-contract.mjs && node scripts/account-system-contract.mjs",
    "encyclopedia:validate": "python scripts/validate_psych_encyclopedia.py",
    "encyclopedia:coverage": "python scripts/encyclopedia_coverage_report.py",
    "encyclopedia:import:dry": "node scripts/import_psych_encyclopedia.mjs",
    "encyclopedia:import": "node scripts/import_psych_encyclopedia.mjs --apply",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.110.9",
    "lucide-react": "^0.536.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.115.0"
  }
}
