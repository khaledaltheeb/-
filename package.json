{
  "name": "rawafid-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node scripts/build_psych_encyclopedia_assets.mjs && next dev",
    "build": "node scripts/build_psych_encyclopedia_assets.mjs && next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "generate:og-assets": "node scripts/generate-static-og-assets.mjs",
    "validate:og-assets": "node scripts/validate-static-og-assets.mjs",
    "cognitive-lab-check": "node scripts/cognitive-lab-contract.mjs",
    "content-v6-check": "node scripts/content-release-contract-v6.mjs --self-test",
    "migration-queue-v6-check": "node scripts/migration-queue-v6-contract.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "architecture-check": "node scripts/quality-contract.mjs && node scripts/psych-encyclopedia-assets-contract.mjs && node scripts/theme-contract-v5.mjs && node scripts/theme-dead-code-check.mjs && node scripts/provider-system-contract.mjs && node scripts/account-system-contract.mjs && node scripts/validate-static-og-assets.mjs && node scripts/cognitive-lab-contract.mjs && node scripts/content-release-contract-v6.mjs --self-test && node scripts/migration-queue-v6-contract.mjs",
    "theme-check": "node scripts/theme-contract-v5.mjs && node scripts/theme-dead-code-check.mjs",
    "provider-system-check": "node scripts/provider-system-contract.mjs && node scripts/account-system-contract.mjs",
    "smoke": "node scripts/smoke.mjs",
    "encyclopedia:assets": "node scripts/build_psych_encyclopedia_assets.mjs",
    "encyclopedia:assets:check": "node scripts/psych-encyclopedia-assets-contract.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-arabic": "5.3.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.110.9",
    "lucide-react": "^0.536.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "sharp": "^0.35.3",
    "typescript": "^5.9.0",
    "wrangler": "^4.115.0"
  }
}
