{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rawafid-platform-staging",
  "account_id": "1910e1ad3c793fd568ba1caafe34f964",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "minify": true,
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://rawafid-platform-staging.khaledaltheeb.workers.dev",
    "NEXT_PUBLIC_ALLOW_INDEXING": "false",
    "NEXT_PUBLIC_ENABLE_ANALYTICS": "false"
  },
  "env": {
    "production": {
      "name": "rawafid-platform-production",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "healthrenewal.org",
          "custom_domain": true
        }
      ],
      "vars": {
        "NEXT_PUBLIC_SITE_URL": "https://healthrenewal.org",
        "NEXT_PUBLIC_ALLOW_INDEXING": "true",
        "NEXT_PUBLIC_ENABLE_ANALYTICS": "false"
      }
    }
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
