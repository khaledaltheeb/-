{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rawafid-platform-staging",
  "account_id": "1910e1ad3c793fd568ba1caafe34f964",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "minify": true,
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://ghljwfwqsyfnthvlzxjy.supabase.co",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable__GMG8aQnofuk_6RLm3UfUg_fIzuSzSs",
    "NEXT_PUBLIC_SITE_URL": "https://rawafid-platform-staging.khaledaltheeb.workers.dev",
    "NEXT_PUBLIC_ALLOW_INDEXING": "false",
    "NEXT_PUBLIC_ENABLE_ANALYTICS": "false"
  },
  "env": {
    "production": {
      "name": "rawafid-platform-production",
      "workers_dev": false,
      "preview_urls": false,
      // Legacy Actions snapshot compatibility markers only. These comments are
      // intentionally non-operative; production routing is defined by the
      // wildcard zone routes immediately below.
      // "pattern": "healthrenewal.org"
      // "pattern": "www.healthrenewal.org"
      // "custom_domain": true
      "routes": [
        {
          "pattern": "healthrenewal.org/*",
          "zone_name": "healthrenewal.org"
        },
        {
          "pattern": "www.healthrenewal.org/*",
          "zone_name": "healthrenewal.org"
        }
      ],
      "vars": {
        "NEXT_PUBLIC_SUPABASE_URL": "https://ghljwfwqsyfnthvlzxjy.supabase.co",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable__GMG8aQnofuk_6RLm3UfUg_fIzuSzSs",
        "NEXT_PUBLIC_SITE_URL": "https://healthrenewal.org",
        "NEXT_PUBLIC_ALLOW_INDEXING": "true",
        "NEXT_PUBLIC_ENABLE_ANALYTICS": "true",
        "NEXT_PUBLIC_GTM_ID": "GTM-WBLQVBG4",
        "NEXT_PUBLIC_GA_MEASUREMENT_ID": "G-VLZMV8Y4JP",
        "NEXT_PUBLIC_ENABLE_DIRECT_GA": "true"
      }
    }
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
