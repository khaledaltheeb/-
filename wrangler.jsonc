{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rawafid-platform-staging",
  "account_id": "1910e1ad3c793fd568ba1caafe34f964",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "minify": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
